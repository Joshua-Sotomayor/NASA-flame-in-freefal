# Configuracion de ejecucion segura (sin secretos ni API keys privadas requeridas)
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000

# Seguridad HTTP / CORS / Anti-DDoS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_REQ_PER_MIN=60
RATE_LIMIT_ML_REQ_PER_MIN=20
MAX_PAYLOAD_BYTES=16384

# Conexion opcional de solo lectura a NASA OSDR (allowlist fija en codigo)
OSDR_TIMEOUT_SEC=3.0
OSDR_LIVE_ENABLED=false

# Verificacion criptografica obligatoria de modelos ML/DL (.joblib / .onnx)
VERIFY_MODEL_SHA256=true
MODEL_MANIFEST_PATH=artifacts/models/manifest.sha256.json
